# ============================================
# MedVision AI - Environment Configuration
# ============================================
# Copy this file to .env and configure values
# ============================================

# Application Settings
APP_NAME=MedVision AI
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# API Configuration
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database Configuration
POSTGRES_USER=medvision
POSTGRES_PASSWORD=medvision_dev_password_change_in_production
POSTGRES_DB=medvision_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Security & Authentication
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage Configuration
LOCAL_STORAGE_ROOT=/app/storage
MAX_UPLOAD_SIZE_MB=500

# AI Model Configuration (Future)
ENABLE_MOCK_MODELS=true
DEFAULT_MODEL_KEY=chest_xray_classifier
MODEL_STORAGE_PATH=/app/models
INFERENCE_DEVICE=cpu

# LLM Configuration (Future)
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# RAG Configuration (Future)
ENABLE_RAG=false
VECTOR_DB_PATH=/app/vector_db
EMBEDDING_MODEL=text-embedding-ada-002

# Monitoring & Logging
LOG_LEVEL=INFO
ENABLE_METRICS=true
SENTRY_DSN=

# Redis Configuration (Future)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=MedVision AI